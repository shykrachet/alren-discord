DISCORD_TOKEN=your-token-here
# An OpenAI key (sk-...) or an OpenRouter key (sk-or-...) is supported.
OPENAI_API_KEY=your-openai-api-key-here
# For an OpenAI key use gpt-5.4-mini; for an OpenRouter key use openai/gpt-5-mini.
OPENAI_MODEL=gpt-5.4-mini
# Leave blank for automatic setup. Set this only for another OpenAI-compatible provider.
AI_BASE_URL=
