DISCORD_TOKEN=your-token-here
# An OpenAI key (sk-...) or an OpenRouter key (sk-or-...) is supported.
OPENAI_API_KEY=your-openai-api-key-here
# For an OpenAI key use gpt-5.4-mini; for an OpenRouter key use openai/gpt-5-mini.
OPENAI_MODEL=gpt-5.4-mini
# Leave blank for automatic setup. Set this only for another OpenAI-compatible provider.
AI_BASE_URL=
# The private /alren response is deleted after this many seconds (15-3600).
EPHEMERAL_CHAT_TTL_SECONDS=300
# How often the automatic osu! beatmap feed checks for updates (30-3600 seconds).
OSU_MAP_FEED_INTERVAL_SECONDS=30
# How often BN open/closed status and Mappers' Guild updates are checked (30-3600 seconds).
COMMUNITY_ALERT_INTERVAL_SECONDS=30
# Deadline per BN / Mappers' Guild API attempt (1000-120000 ms); transient failures retry once.
COMMUNITY_ALERT_REQUEST_TIMEOUT_MS=30000

# osu! OAuth app credentials. Register the redirect URL below in osu! account settings.
OSU_CLIENT_ID=
OSU_CLIENT_SECRET=
# This must be a publicly reachable URL and exactly match the osu! OAuth app callback URL.
OSU_REDIRECT_URI=https://your-domain.example/osu/callback
# Local port used by the callback server. Railway supplies PORT automatically.
VERIFY_PORT=3000

# SQLite database file path (defaults to ./data/alren.sqlite when not specified).
# Railway: attach a persistent Volume at /app/data for the path below.
# Alternatively leave SQLITE_PATH unset to use RAILWAY_VOLUME_MOUNT_PATH automatically.
SQLITE_PATH=./data/alren.sqlite
